# Скопируйте в .env: cp .env.example .env
# Пароль должен совпадать с паролем роли studio_crm (см. README, «Локальный запуск»).

# Рабочая база приложения
DATABASE_URL="postgresql://studio_crm:studio_crm@localhost:5432/studio_crm?schema=public"

# База для автоматических тестов и проверок с изменением данных (нужна только для npm test)
TEST_DATABASE_URL="postgresql://studio_crm:studio_crm@localhost:5432/studio_crm_agent?schema=public"

# Часовой пояс для «сегодня» и просроченных задач
APP_TIME_ZONE="Europe/Moscow"
